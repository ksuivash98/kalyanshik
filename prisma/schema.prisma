generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String   @default("Кальянщик")
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tobaccos UserTobacco[]
  mixes    Mix[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  tobaccos  Tobacco[]

  @@index([name])
}

model Tobacco {
  id          String   @id @default(cuid())
  brandId     String
  name        String
  slug        String
  description String?
  tags        String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  brand           Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  profile         FlavorProfile?
  userTobaccos    UserTobacco[]
  mixIngredients  MixIngredient[]

  @@unique([brandId, slug])
  @@index([name])
  @@index([brandId])
}

model FlavorProfile {
  id         String  @id @default(cuid())
  tobaccoId  String  @unique
  strength   Int
  cold       Int
  sweetness  Int
  sourness   Int
  fruity     Int
  dessert    Int
  spicy      Int
  herbal     Int
  intensity  Int

  tobacco Tobacco @relation(fields: [tobaccoId], references: [id], onDelete: Cascade)
}

model UserTobacco {
  id        String   @id @default(cuid())
  userId    String
  tobaccoId String
  grams     Float    @default(0)
  rating    Int?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tobacco Tobacco @relation(fields: [tobaccoId], references: [id], onDelete: Cascade)

  @@unique([userId, tobaccoId])
  @@index([userId])
  @@index([tobaccoId])
}

model Mix {
  id          String   @id @default(cuid())
  userId      String
  name        String
  totalGrams  Float
  tobaccoCount Int
  strength    Float
  cold        Float
  sweetness   Float
  sourness    Float
  fruity      Float
  dessert     Float
  spicy       Float
  herbal      Float
  intensity   Float
  explanation String?
  variantType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients MixIngredient[]
  rating      MixRating?

  @@index([userId])
  @@index([createdAt])
}

model MixIngredient {
  id         String @id @default(cuid())
  mixId      String
  tobaccoId  String
  role       String
  percent    Float
  grams      Float

  mix     Mix     @relation(fields: [mixId], references: [id], onDelete: Cascade)
  tobacco Tobacco @relation(fields: [tobaccoId], references: [id], onDelete: Cascade)

  @@index([mixId])
  @@index([tobaccoId])
}

model MixRating {
  id        String   @id @default(cuid())
  mixId     String   @unique
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mix Mix @relation(fields: [mixId], references: [id], onDelete: Cascade)
}
